meta {
  name: Atualizar livro
  type: http
  seq: 4
}

put {
  url: http://localhost:8080/api/livros/{{livroId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "titulo": "O Hobbit - Edição Especial",
    "isbn": "9788595084742",
    "autor": "J. R. R. Tolkien",
    "categoria": "FANTASIA",
    "anoPublicacao": 1937,
    "quantidade": 10
  }
}

tests {
  test("Status deve ser 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Título deve ter sido atualizado", function() {
    expect(res.body.titulo).to.equal("O Hobbit - Edição Especial");
  });
}
